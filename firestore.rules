rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    match /tickets/{id} { allow read, write: if request.auth != null; }
    match /{col}/{id} { allow read, write: if request.auth != null && col in ['parts','movements','receivings','deliveries','products','customers','payments']; }
    // Public tracking: customers can fetch ONE document by code/phone, never list them
    match /tracking/{id}      { allow get: if true; allow list: if false; allow write: if request.auth != null; }
    match /trackingPhone/{id} { allow get: if true; allow list: if false; allow write: if request.auth != null; }
  }
}

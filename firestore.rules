rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function prof() { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data; }
    function active() { return signedIn() && exists(/databases/$(db)/documents/users/$(request.auth.uid)) && prof().active == true; }
    function anyOf(rs) { return active() && prof().role in rs; }
    // Bootstrap owner(s): put the real owner email(s) here (same as ADMIN_EMAILS) before publishing.
    // The email must be VERIFIED: the online shop lets anyone create an account, so an unverified
    // email is no proof of identity (without this check anyone could sign up as the owner and become admin).
    function isOwner() { return signedIn() && request.auth.token.email_verified == true && request.auth.token.email in ['owner@example.com']; }
    function staff() { return anyOf(['reception','sales','technician','inventory','manager','admin']); }
    // repair shop front desk
    function front() { return anyOf(['reception','manager','admin']); }
    // sales counter + online shop
    function sales() { return anyOf(['sales','manager','admin']); }
    // both counters (shared customer list, registers, invoices)
    function counter() { return anyOf(['reception','sales','manager','admin']); }
    function boss()  { return anyOf(['manager','admin']); }
    // attendance: a clock-in must carry the current rotating kiosk code (unless the manager turned the QR requirement off)
    function qrOk() {
      return (exists(/databases/$(db)/documents/settings/attendance) && get(/databases/$(db)/documents/settings/attendance).data.get('requireQR', true) == false)
        || (exists(/databases/$(db)/documents/attendanceKiosk/current)
            && request.resource.data.token in [get(/databases/$(db)/documents/attendanceKiosk/current).data.token, get(/databases/$(db)/documents/attendanceKiosk/current).data.prev]
            && request.time < get(/databases/$(db)/documents/attendanceKiosk/current).data.expires);
    }
    function onlyKeys(k) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(k); }

    // roles a manager may give when adding staff (never manager or admin)
    function staffRole(r) { return r in ['reception','sales','technician','inventory']; }
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || boss());
      allow create: if (isOwner() && request.auth.uid == uid) || anyOf(['admin'])
        || (boss() && staffRole(request.resource.data.role) && request.resource.data.keys().hasOnly(['email','name','username','role','active','phone','createdAt','createdBy']));
      // a manager may rename, change the login name or switch off staff, but never change a role
      allow update: if anyOf(['admin']) || (isOwner() && request.auth.uid == uid)
        || (boss() && staffRole(resource.data.role) && onlyKeys(['name','username','active','phone','updatedAt']));
      allow delete: if anyOf(['admin']);
    }
    match /tickets/{id} {
      allow read: if front() || anyOf(['inventory']) || (anyOf(['technician']) && (resource.data.techId == request.auth.uid || resource.data.repairedBy == request.auth.uid));
      allow create: if front();
      allow update: if front()
        || (anyOf(['technician']) && resource.data.techId == request.auth.uid && onlyKeys(['status','items','services','history','updatedAt','pendingQuote','noRepair','repairedBy','repairedByName','repairedAt','repairLevel']))
        || (anyOf(['inventory']) && onlyKeys(['items','updatedAt']));
      allow delete: if boss();
      match /photos/{pid} {
        allow read: if front() || anyOf(['technician']);
        allow create, delete: if front();
      }
    }
    match /projects/{id} { allow read: if staff(); allow write: if boss(); }
    match /tasks/{id} {
      allow read: if staff() && (!anyOf(['technician']) || resource.data.assigneeId == request.auth.uid);
      allow create: if boss() || (staff() && !anyOf(['technician']) && request.resource.data.assigneeId == request.auth.uid && request.resource.data.createdBy == request.auth.uid)
        || (staff() && request.resource.data.auto == true && request.resource.data.createdBy == request.auth.uid && (id.matches('auto_.*') || id.matches('rec_.*')));
      allow update: if boss() || (staff() && !anyOf(['technician']) && resource.data.assigneeId == request.auth.uid && onlyKeys(['status','checklist','comments','updatedAt','completedAt']))
        || (staff() && !anyOf(['technician']) && request.resource.data.assigneeId == resource.data.assigneeId && onlyKeys(['comments','updatedAt']));
      allow delete: if boss();
    }
    // staff sign in with a name: public lookup of ONE document (never a list)
    match /taskRules/{id} { allow read: if staff(); allow write: if boss(); }
    match /taskTemplates/{id} { allow read: if staff(); allow write: if boss(); }
    match /usernames/{n} { allow get: if true; allow list: if false; allow write: if anyOf(['admin']);
      allow create, update: if boss() && staffRole(get(/databases/$(db)/documents/users/$(request.resource.data.uid)).data.role);
      allow delete: if boss() && staffRole(get(/databases/$(db)/documents/users/$(resource.data.uid)).data.role); }
    // wholesale clients of the online shop
    function b2b() { return get(/databases/$(db)/documents/b2b/$(request.auth.uid)).data; }
    match /b2b/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || sales();
      allow create: if sales() || signedIn() && request.auth.uid == uid && request.resource.data.status == 'pending' && request.resource.data.tier == 'r' && request.resource.data.discount == 0
        && request.resource.data.keys().hasOnly(['name','phone','company','email','status','tier','discount','createdAt']);
      allow update: if sales() || (signedIn() && request.auth.uid == uid && onlyKeys(['name','phone','company']));
      allow delete: if boss();
    }
    match /tierPrices/{id} {
      allow read: if staff() || (signedIn() && exists(/databases/$(db)/documents/b2b/$(request.auth.uid)) && b2b().status == 'approved' && resource.data.tier == b2b().tier);
      allow write: if boss() || sales();
    }
    // HR files (salary, ID numbers...): managers and admins only
    match /staffProfiles/{id} { allow read, write: if boss(); }
    match /technicians/{id} { allow read: if staff(); allow write: if boss(); }
    match /userPrefs/{uid} { allow read, write: if signedIn() && request.auth.uid == uid; }
    match /settings/{id} { allow read: if staff(); allow write: if anyOf(['admin']); }
    // the shop's own repair problems (one doc per device type), added from the ticket window
    match /problemList/{type} {
      allow read: if staff();
      allow create, update: if front() && type in ['phone','tablet','laptop'] && request.resource.data.keys().hasOnly(['list','updatedAt']) && request.resource.data.list is list && request.resource.data.list.size() <= 300;
      allow delete: if boss();
    }
    // Public tracking: customers can fetch ONE document by code/phone, never list them
    match /tracking/{id}      { allow get: if true; allow list: if false; allow write: if staff(); }
    match /trackingPhone/{id} { allow get: if true; allow list: if false; allow write: if staff(); }
    // ---- Online shop ----
    match /shopItems/{id} { allow read: if true; allow create, delete: if boss(); allow update: if boss() || (staff() && onlyKeys(['qty'])); }
    match /shopDetails/{id} { allow get: if true; allow list: if false; allow write: if boss(); }
    match /shopPublic/{id} { allow read: if true; allow write: if anyOf(['admin']); }
    match /shopCustomers/{uid} { allow read, write: if signedIn() && request.auth.uid == uid; allow read: if sales(); }
    match /orders/{id} {
      allow create: if sales() || (request.resource.data.status == 'new'
        && request.resource.data.keys().hasOnly(['code','uid','customer','address','delivery','notes','items','subtotal','fee','total','status','payment','createdAt','history','lang'])
        && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 40
        && (request.resource.data.get('uid', null) == null || (signedIn() && request.resource.data.uid == request.auth.uid)));
      allow read: if sales() || (signedIn() && resource.data.get('uid', null) == request.auth.uid);
      allow update: if sales() || (signedIn() && resource.data.get('uid', null) == request.auth.uid && resource.data.status == 'new' && request.resource.data.status == 'cancelled' && onlyKeys(['status','history']));
      allow delete: if boss();
    }
    match /orderTrack/{id} {
      allow get: if true; allow list: if false;
      allow create: if sales() || (request.resource.data.status == 'new' && request.resource.data.code == id
        && request.resource.data.keys().hasOnly(['code','status','name','items','total','delivery','createdAt','history'])
        && request.resource.data.items is list && request.resource.data.items.size() <= 40);
      allow update: if sales() || (resource.data.status == 'new' && request.resource.data.status == 'cancelled' && onlyKeys(['status','history']));
      allow delete: if boss();
    }
    match /customers/{id} { allow read, write: if counter(); }
    match /payments/{id} {
      allow read, create: if counter();
      allow update, delete: if boss() || (anyOf(['admin']) && resource.data.demo == true);
    }
    match /parts/{id} {
      allow read: if staff();
      allow create, delete: if boss();
      allow update: if boss() || (staff() && onlyKeys(['qty']));
    }
    match /products/{id} {
      allow read: if staff();
      allow create, delete: if boss();
      allow update: if boss() || (staff() && onlyKeys(['qty']));
    }
    match /movements/{id} {
      allow read, create: if staff();
      allow delete: if anyOf(['admin']) && resource.data.demo == true;
    }
    match /receivings/{id} { allow read: if staff(); allow write: if boss(); }
    match /deliveries/{id} {
      allow read: if sales() || front();
      allow create: if sales() || front();
      allow update, delete: if boss();
    }
    match /registers/{id} { allow read: if counter(); allow write: if boss(); }
    match /cashEntries/{id} { allow read: if boss(); allow create: if counter(); allow update, delete: if boss(); }
    match /expenses/{id} {
      allow read: if boss() && (resource.data.adminOnly == false || anyOf(['admin']));
      allow create: if boss();
      allow update, delete: if boss() && (resource.data.adminOnly == false || anyOf(['admin']));
    }
    match /losses/{id} { allow read, write: if boss(); }
    match /dayClosings/{id} {
      allow read, create: if boss();
      allow update: if boss() && (resource.data.locked != true || anyOf(['admin']));
      allow delete: if anyOf(['admin']);
    }
    match /suppliers/{id} { allow read: if boss() || anyOf(['inventory']); allow write: if boss(); }
    match /supplierPayments/{id} { allow read, create: if boss(); allow update, delete: if anyOf(['admin']); }
    match /returns/{id} { allow read, create: if sales(); allow update, delete: if anyOf(['admin']); }
    match /counters/{id} { allow read, write: if counter() || anyOf(['inventory']); }
    match /partNeeds/{id} { allow read, create: if staff(); allow update: if anyOf(['inventory','reception','manager','admin']); allow delete: if boss(); }
    match /purchaseOrders/{id} { allow read, create, update: if boss() || anyOf(['inventory']); allow delete: if anyOf(['admin']); }
    match /invoices/{id} {
      allow read: if boss() || (counter() && resource.data.partyType == 'customer');
      allow create: if boss() || (counter() && request.resource.data.partyType == 'customer');
      allow update: if boss();
      allow delete: if anyOf(['admin']);
    }
    match /dailyChecks/{id} { allow read, create, update: if staff(); allow delete: if boss(); }
    match /dailyDays/{id} { allow read, create, update: if staff(); allow delete: if boss(); }
    match /dailyLogs/{id} { allow read, create: if staff(); allow update, delete: if boss(); }
    match /stockCounts/{id} {
      allow read, create, update: if boss();
      allow delete: if anyOf(['admin']);
      match /lines/{l} { allow read, write: if boss(); }
    }
    match /priceLog/{id} { allow read, create: if boss(); }
    match /feedback/{id} {
      allow read: if staff();
      allow create: if request.resource.data.keys().hasOnly(['code','rating','comment','createdAt']) && request.resource.data.code == id && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5 && request.resource.data.comment is string && request.resource.data.comment.size() <= 500 && request.resource.data.createdAt == request.time && exists(/databases/$(db)/documents/tracking/$(id));
      allow update, delete: if anyOf(['admin']);
    }
    match /heldSales/{id} { allow read, write: if sales(); }
    match /fcmTokens/{t} { allow create, update: if active() && request.resource.data.uid == request.auth.uid; allow delete: if active() && resource.data.uid == request.auth.uid; allow read: if boss(); }
    match /settings/attendance { allow read: if staff(); allow write: if boss(); }
    match /attendanceKiosk/{id} { allow read, write: if boss(); }
    match /attendanceLogs/{id} {
      allow read: if boss() || (staff() && resource.data.uid == request.auth.uid);
      allow create: if boss() || (staff() && request.resource.data.uid == request.auth.uid && request.resource.data.manual == false
        && request.resource.data.type in ['in','out','breakStart','breakEnd'] && request.resource.data.at == request.time && qrOk());
      allow update, delete: if boss();
    }
    match /staffSchedules/{uid} { allow read: if boss() || (staff() && request.auth.uid == uid); allow write: if boss(); }
    match /leaves/{id} {
      allow read: if boss() || (staff() && resource.data.uid == request.auth.uid);
      allow create: if boss() || (staff() && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'pending');
      allow update: if boss();
      allow delete: if boss() || (staff() && resource.data.uid == request.auth.uid && resource.data.status == 'pending');
    }
    match /audit/{id} { allow read: if boss(); allow create: if staff(); }
  }
}

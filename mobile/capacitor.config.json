{
  "appId": "com.mahdirepair.app",
  "appName": "Mahdi Repair",
  "webDir": "www",
  "server": {
    "url": "https://chihabfortas.github.io/MAHDI-REPAIR/app.html",
    "cleartext": false,
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "backgroundColor": "#0a0e11"
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound"
      ]
    },
    "StatusBar": {
      "overlaysWebView": false,
      "backgroundColor": "#e8f4fa",
      "style": "LIGHT"
    }
  },
  "android": {
    "adjustMarginsForEdgeToEdge": "force"
  }
}